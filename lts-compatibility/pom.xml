<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        An ordinary Quarkus application, pinned to the oldest Quarkus version this extension declares
        support for, used to verify that claim on every commit.

        The extension is built against the newest Quarkus (see quarkus.version in the root pom) but
        declares a lower floor through requiresQuarkusCore. Nothing enforces that floor: a build step
        using an API added after it would compile here, pass every CI leg, and only fail for a user on
        the LTS, during their own build, when Quarkus runs augmentation and executes our build steps
        against their older classes. Building this application reproduces exactly that.

        DELIBERATELY NOT A MODULE OF THE ROOT POM, AND DELIBERATELY WITHOUT A <parent>. Inheriting
        quarkus-jdbc-edb-parent would bring its quarkus.version and dependencyManagement with it, and
        this project would then resolve the newest Quarkus while appearing to test the LTS: a green
        check proving nothing. For the same reason the platform version below is written out rather
        than generated: `quarkus-maven-plugin:3.33.3:create` does not pin the platform, it writes
        whichever version is newest in the stream.
    -->
    <groupId>io.quarkiverse.edb</groupId>
    <artifactId>quarkus-jdbc-edb-lts-compatibility</artifactId>
    <version>999-SNAPSHOT</version>
    <name>Quarkus JDBC EDB - LTS Compatibility Check</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!--
            The floor declared by requiresQuarkusCore. Change both together, never one alone.
        -->
        <quarkus.platform.version>3.33.3</quarkus.platform.version>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>

        <!-- Overridable so a release build can point this at the version being released. -->
        <jdbc-edb.version>999-SNAPSHOT</jdbc-edb.version>

        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.edb</groupId>
            <artifactId>quarkus-jdbc-edb</artifactId>
            <version>${jdbc-edb.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
