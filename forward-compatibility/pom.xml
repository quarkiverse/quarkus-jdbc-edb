<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        An ordinary Quarkus application, pinned to the NEWEST Quarkus release, used to verify on every
        commit that an extension built against the LTS still works on a current core.

        That is the risk this project exists for. The extension is compiled against the oldest
        supported LTS (see quarkus.version in the root pom), because the extension registry makes that
        the only way to be discoverable to LTS users. Most users, however, are on a much newer core,
        and nothing else proves the extension still behaves there: the ecosystem CI workflow builds
        against Quarkus main, which is a different question from the current release.

        DELIBERATELY NOT A MODULE OF THE ROOT POM, AND DELIBERATELY WITHOUT A <parent>. Inheriting
        quarkus-jdbc-edb-parent would bring its quarkus.version and dependencyManagement with it, and
        this project would then resolve the LTS while appearing to test the newest release: a green
        check proving nothing. For the same reason the platform version below is written out rather
        than generated. `quarkus-maven-plugin:<version>:create` does not pin the platform, it writes
        whichever version is newest in the stream.
    -->
    <groupId>io.quarkiverse.edb</groupId>
    <artifactId>quarkus-jdbc-edb-forward-compatibility</artifactId>
    <version>999-SNAPSHOT</version>
    <name>Quarkus JDBC EDB - Forward Compatibility Check</name>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>

        <!--
            The newest Quarkus release. Bump this as new releases appear; it is the upper end of the
            range we claim to work on, and is intentionally far from the LTS we compile against.
        -->
        <quarkus.platform.version>3.39.2</quarkus.platform.version>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>

        <!-- Overridable so a release build can point this at the version being released. -->
        <jdbc-edb.version>999-SNAPSHOT</jdbc-edb.version>

        <compiler-plugin.version>3.14.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-agroal</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkiverse.edb</groupId>
            <artifactId>quarkus-jdbc-edb</artifactId>
            <version>${jdbc-edb.version}</version>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <goals>
                            <goal>build</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
